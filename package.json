{
  "name": "obsidian-simboard",
  "version": "0.1.0",
  "description": "A widget-based home dashboard for Obsidian: banner with clock and calendar, quick links, a file-backed todo list and vault activity.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint src",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dashboard",
    "homepage"
  ],
  "author": "zhezhou",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "~5.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
