# Copy to .env.local (git-ignored) to sync every build into a vault.
# Copy to .env.test.local for a second, throwaway test vault used by
# `npm run dev:test` / `npm run build:test`.
# Absolute path of the vault root (the folder that contains .obsidian/).
OBSIDIAN_VAULT=/path/to/your/vault
# Vault name for the Obsidian CLI hot reload (defaults to the folder name).
# OBSIDIAN_VAULT_NAME=my_vault
# Set to 0 to copy files without asking Obsidian to reload the plugin.
# OBSIDIAN_RELOAD=1
