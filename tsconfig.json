{
	"compilerOptions": {
		"baseUrl": "src",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2020",
		"allowJs": false,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strict": true,
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"importHelpers": true,
		"lib": ["DOM", "DOM.Iterable", "ES2020"]
	},
	"include": ["src/**/*.ts"]
}
